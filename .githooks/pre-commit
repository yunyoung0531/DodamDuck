#!/usr/bin/env bash
# 스테이징된 파일만 검사한다. 자동으로 고치지 않는다.
#
# ESLint는 `pnpm lint`와 같은 범위(src/의 ts, tsx)만 보고, 경고는 막지 않는다.
# 기존 경고가 남아 있어 경고까지 막으면 그 파일을 건드리는 커밋이 모두 막힌다.
#
# 경로는 -z로 받는다. 기본 core.quotepath가 한글 파일명을 인용해 검사에서 빠지는 것을 피한다.

staged=()
while IFS= read -r -d '' path; do
  staged+=("$path")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

[ ${#staged[@]} -eq 0 ] && exit 0

lintable=()
for path in "${staged[@]}"; do
  case "$path" in
    src/*.ts | src/*.tsx) lintable+=("$path") ;;
  esac
done

failed=0

if [ ${#lintable[@]} -gt 0 ]; then
  pnpm exec eslint "${lintable[@]}" || failed=1
fi

pnpm exec prettier --check --ignore-unknown "${staged[@]}" || failed=1

if [ $failed -ne 0 ]; then
  echo "[pre-commit] 고친 뒤 다시 add 한다. 포맷은 pnpm format, 린트는 pnpm lint --fix로 고친다" >&2
  exit 1
fi
