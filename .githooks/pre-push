#!/usr/bin/env bash
# GitHub 자동 PR 생성 pre-push 훅 (디스패처)
#
# push되는 브랜치마다 워커(github_pr.py)를 백그라운드로 실행한다.
# pre-push 시점엔 remote에 브랜치가 아직 없으므로, 워커가 반영을 폴링한 뒤
# 열린 PR이 없을 때만 PR을 만든다. push 자체는 절대 막지 않는다.
#
# git 인자: $1=remote 이름, $2=remote URL
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" 여러 줄

remote_url="$2"
hook_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(git rev-parse --show-toplevel)"
log_file="$repo_root/.git/github-pr.log"
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  # 브랜치 삭제 push는 무시
  [ "$local_sha" = "$zero" ] && continue

  case "$local_ref" in
    refs/heads/*) branch="${local_ref#refs/heads/}" ;;
    *) continue ;;
  esac

  # 워커를 완전히 분리해 백그라운드 실행 (push 진행을 막지 않음)
  nohup python3 "$hook_dir/github_pr.py" "$branch" "$local_sha" "$remote_url" \
    >>"$log_file" 2>&1 &
  disown 2>/dev/null || true
done
